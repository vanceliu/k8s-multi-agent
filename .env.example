# POC Authentication Tokens
POC_STATIC_TOKEN=your-static-token-here
POC_ADMIN_TOKEN=your-admin-token-here

# Database
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/claw_data

# LLM (OpenAI-compatible)
OPENAI_API_BASE=http://localhost:1234/v1
OPENAI_API_KEY=your-api-key-here

# Sub-agent LLM (optional, falls back to above)
# SUB_AGENT_MODEL=
# SUB_AGENT_API_BASE=
# SUB_AGENT_API_KEY=

# CWA Weather API (Taiwan Central Weather Administration)
CWA_API_KEY=your-cwa-api-key-here
CWA_API_BASE=https://opendata.cwa.gov.tw/api/v1/rest/datastore

# Agent settings
AGENT_MODEL=qwen/qwen3.6-35b-a3b
AGENT_MODEL_PROVIDER=openai
AGENT_DISPLAY_MODE=full_history

# K8s
K8S_NAMESPACE=agent-platform
AGENT_IMAGE=localhost/k8s-agent-runtime:latest
