# =============================================================================
# k8s-openclaw POC — Environment Variables Template
# -----------------------------------------------------------------------------
# Usage:
#   1. cp .env.example .env
#   2. Fill in real values in .env (never commit .env)
#   3. Load before running:  export $(grep -v '^#' .env | xargs)
#      Or use docker:        docker run --env-file .env ...
#
# Priority: env var > poc/config.yaml > built-in default
# =============================================================================

# -----------------------------------------------------------------------------
# Authentication (POC: static tokens; Production: replace with JWT/OAuth2)
# -----------------------------------------------------------------------------
POC_STATIC_TOKEN=poc-test-token-12345
POC_ADMIN_TOKEN=poc-admin-token-12345

# -----------------------------------------------------------------------------
# Database (PostgreSQL 14+, asyncpg driver)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/claw_data

# -----------------------------------------------------------------------------
# LLM — Supervisor (OpenAI-compatible endpoint)
#   Examples:
#     GLM/Z.ai:  https://api.z.ai/api/coding/paas/v4
#     MiniMax:   https://api.minimax.io/v1
#     OpenAI:    https://api.openai.com/v1
#     Local:     http://localhost:1234/v1
# -----------------------------------------------------------------------------
AGENT_MODEL=glm-5.1
AGENT_MODEL_PROVIDER=openai
OPENAI_API_BASE=https://api.z.ai/api/coding/paas/v4
OPENAI_API_KEY=your-api-key-here

# -----------------------------------------------------------------------------
# LLM — Sub-agents (research_agent + code_agent)
# Leave empty to fall back to supervisor settings above.
# -----------------------------------------------------------------------------
SUB_AGENT_MODEL=glm-5-turbo
# SUB_AGENT_MODEL_PROVIDER=
# SUB_AGENT_API_BASE=
# SUB_AGENT_API_KEY=

# -----------------------------------------------------------------------------
# Agent runtime
# -----------------------------------------------------------------------------
AGENT_DISPLAY_MODE=full_history    # options: normal | full_history
AGENT_DEBUG=false

# -----------------------------------------------------------------------------
# CWA Weather API (Taiwan Central Weather Administration)
# Apply for a free key at: https://opendata.cwa.gov.tw/
# -----------------------------------------------------------------------------
CWA_API_KEY=your-cwa-api-key-here
CWA_API_BASE=https://opendata.cwa.gov.tw/api/v1/rest/datastore

# -----------------------------------------------------------------------------
# LINE Channel (optional — leave empty to disable LINE integration)
# Get values from: https://developers.line.biz/console/
# -----------------------------------------------------------------------------
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Kubernetes
# -----------------------------------------------------------------------------
K8S_NAMESPACE=agent-platform
AGENT_IMAGE=localhost/k8s-agent-runtime:latest
AGENT_PORT=8080

# -----------------------------------------------------------------------------
# Service endpoints (intra-cluster URLs; local dev uses localhost)
# -----------------------------------------------------------------------------
ORCHESTRATOR_HOST=http://localhost:8080
ADMIN_HOST=http://localhost:8090
STORAGE_SERVICE_HOST=http://localhost:8091

# -----------------------------------------------------------------------------
# Lifecycle
# -----------------------------------------------------------------------------
IDLE_TIMEOUT_MINUTES=10
REAP_CHECK_INTERVAL_SECONDS=30

# -----------------------------------------------------------------------------
# Storage (PVC)
# -----------------------------------------------------------------------------
DEFAULT_PVC_SIZE_GB=1
PVC_STORAGE_CLASS=standard
PVC_FILE_SIZE_LIMIT_MB=10
